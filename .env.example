# Copy to .env and fill in.

# --- Required ----------------------------------------------------------------------

# Protects the API; the desktop app asks for it on first login. E.g. `openssl rand -hex 32`
ADMIN_TOKEN=

# Claude subscription tokens for the agents: run `claude setup-token` on each account.
# Several accounts: separate the tokens with "|". The agents are spread evenly over
# them (or set an agent's account in the app); MAX_CONCURRENT_AGENTS applies per account.
CLAUDE_CODE_OAUTH_TOKENS=

# GitHub token used by the backend only (clone, push, pull requests, merges).
# Fine-grained token on your repositories: Contents, Pull requests (read/write),
# Checks and Metadata (read).
GITHUB_TOKEN=

# Database (keep the password URL-safe: letters, digits, - and _)
POSTGRES_PASSWORD=

# --- Optional ----------------------------------------------------------------------

# Server version to run (an image published on ghcr.io/enzoblain/palabre), e.g. 0.1.0
# PALABRE_VERSION=latest

# POSTGRES_USER=palabre
# POSTGRES_DB=palabre
# Port of the Palabre server on the host (the address to give the desktop app)
# PALABRE_PORT=2710
# Port of the web app (the app in a browser: phone, tablet...)
# PALABRE_WEB_PORT=2810

# Automatic updates: every PALABRE_UPDATE_INTERVAL seconds, pull the images and restart
# the server and web app when a new version is out (agents get 60s to stop cleanly)
# COMPOSE_PROFILES=autoupdate
# PALABRE_UPDATE_INTERVAL=300

# Time zone of the daily stand-up
# TZ=Europe/Paris
# DAILY_TIME=09:30
# MERGE_REMINDER_MINUTES=10

# Agents running at the same time, per Claude account
# MAX_CONCURRENT_AGENTS=3

# Toolchains the agents need to build and test your projects (rebuild after a change)
# EXTRA_APT_PACKAGES=nodejs npm
# CLAUDE_CODE_VERSION=stable
