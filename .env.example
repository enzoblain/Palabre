# Copy to .env and fill in. The four secrets below reach the containers as files
# (Docker secrets), not as environment variables.

# --- Required ----------------------------------------------------------------------

# Protects the API; the desktop app asks for it on first login. At least 32 characters
# (the server refuses to start otherwise): `openssl rand -hex 32`. Ten failed attempts from
# one IP lock it out for a few minutes (HTTP 429).
ADMIN_TOKEN=

# Claude subscription tokens for the agents: run `claude setup-token` on each account.
# Several accounts: separate the tokens with "|". The agents are spread evenly over
# them (or set an agent's account in the app); MAX_CONCURRENT_AGENTS applies per account.
CLAUDE_CODE_OAUTH_TOKENS=

# GitHub token used by the backend only (clone, push, pull requests, merges).
# Fine-grained token on your repositories: Contents, Pull requests (read/write),
# Checks and Metadata (read).
GITHUB_TOKEN=

# Database (at least 32 characters, URL-safe: letters, digits, - and _; `openssl rand -hex 32`)
POSTGRES_PASSWORD=

# --- Optional ----------------------------------------------------------------------

# Server version to run (an image published on ghcr.io/enzoblain/palabre), e.g. 0.1.0.
# Pinned in docker-compose.yml; update it on purpose (`latest` is only for the autoupdate profile)
# PALABRE_VERSION=0.10.1

# POSTGRES_USER=palabre
# POSTGRES_DB=palabre
# Port of the Palabre server on the host (the address to give the desktop app)
# PALABRE_PORT=2710
# Address the server port is published on. 127.0.0.1 (default): this machine only; use a TLS reverse proxy
# for remote access (see the README). 0.0.0.0 exposes the API in clear HTTP on every interface
# PALABRE_BIND=127.0.0.1
# Port of the web app (the app in a browser: phone, tablet...)
# PALABRE_WEB_PORT=2810
# Address the web app port is published on. 127.0.0.1 (default): this machine only; use a TLS reverse proxy
# or a private network (Tailscale) for phones. 0.0.0.0 exposes /api in clear HTTP on every interface
# PALABRE_WEB_BIND=127.0.0.1

# Automatic updates (needs PALABRE_VERSION=latest, and gives the updater the Docker socket,
# i.e. root on the host; see the README): every PALABRE_UPDATE_INTERVAL seconds, pull the images and restart
# the server and web app when a new version is out (agents get 60s to stop cleanly)
# COMPOSE_PROFILES=autoupdate
# PALABRE_UPDATE_INTERVAL=300

# Time zone of the daily stand-up
# TZ=Europe/Paris
# DAILY_TIME=09:30
# MERGE_REMINDER_MINUTES=10

# Agents running at the same time, per Claude account
# MAX_CONCURRENT_AGENTS=3

# Toolchains the agents need to build and test your projects (rebuild after a change)
# EXTRA_APT_PACKAGES=nodejs npm
# Claude Code is pinned with its checksum in backend/Dockerfile; to change it, edit the ARGs there
